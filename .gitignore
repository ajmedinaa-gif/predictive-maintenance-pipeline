# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.ipynb_checkpoints/

# ---- Entorno (uv) ----
.venv/
venv/
.env

# ---- Datos derivados ----
# data/raw/lab180/ SÍ se versiona: es un CSV pequeño y simulado, la entrada
# fija del pipeline (CLAUDE.md §7). data/raw/ai4i2020/ NO: es un dataset
# externo de ~10 000 filas que se descarga con un paso explícito y separado
# (`pdm-cli download --dataset ai4i2020`, CLAUDE.md §2.11) -- nunca un efecto
# lateral, y tampoco algo que este repositorio deba redistribuir.
data/raw/ai4i2020/
data/interim/*
!data/interim/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep

# ---- Salidas del pipeline ----
# Se regeneran con `make all`; no se versionan. Excepción a propósito
# (CLAUDE.md §2.16): los PNG de reports/figures/ SÍ se versionan, porque el
# destinatario del repo no ejecuta el código.
reports/*
!reports/.gitkeep
!reports/figures/
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/**/
!reports/figures/**/*.png

# ---- macOS (CLAUDE.md §14.6) ----
.DS_Store
._*
.Spotlight-V100
.Trashes
__MACOSX

# ---- Editores ----
.idea/
.vscode/

# ---- respaldo temporal, no versionar ----
.CLAUDE.md.bak
